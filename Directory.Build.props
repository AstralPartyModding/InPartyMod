<Project>
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    
    <!-- 版本信息 -->
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0</AssemblyVersion>
    <FileVersion>0.1.0</FileVersion>
    
    <!-- 启用自动绑定重定向 -->
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    
    <!-- MelonLoader路径 - 请根据实际路径修改 -->
    <MelonLoaderPath>F:\dowmload\steamapps\common\Astral Party\8vJXn6CN\MelonLoader</MelonLoaderPath>
  </PropertyGroup>
  
  <ItemGroup>
    <!-- 绑定重定向：将高版本System.Runtime等系统程序集重定向到6.0版本 -->
    <AssemblyBindingRedirect Include="System.Runtime">
      <AssemblyVersion>0.0.0.0-9.0.0.0</AssemblyVersion>
      <NewVersion>6.0.0.0</NewVersion>
      <Culture>neutral</Culture>
      <PublicKeyToken>b03f5f7f11d50a3a</PublicKeyToken>
    </AssemblyBindingRedirect>
    <AssemblyBindingRedirect Include="System">
      <AssemblyVersion>0.0.0.0-9.0.0.0</AssemblyVersion>
      <NewVersion>6.0.0.0</NewVersion>
      <Culture>neutral</Culture>
      <PublicKeyToken>b03f5f7f11d50a3a</PublicKeyToken>
    </AssemblyBindingRedirect>
    <AssemblyBindingRedirect Include="System.Core">
      <AssemblyVersion>0.0.0.0-9.0.0.0</AssemblyVersion>
      <NewVersion>6.0.0.0</NewVersion>
      <Culture>neutral</Culture>
      <PublicKeyToken>b03f5f7f11d50a3a</PublicKeyToken>
    </AssemblyBindingRedirect>
    <AssemblyBindingRedirect Include="System.Private.CoreLib">
      <AssemblyVersion>0.0.0.0-9.0.0.0</AssemblyVersion>
      <NewVersion>6.0.0.0</NewVersion>
      <Culture>neutral</Culture>
      <PublicKeyToken>b03f5f7f11d50a3a</PublicKeyToken>
    </AssemblyBindingRedirect>
    <AssemblyBindingRedirect Include="System.Console">
      <AssemblyVersion>0.0.0.0-9.0.0.0</AssemblyVersion>
      <NewVersion>6.0.0.0</NewVersion>
      <Culture>neutral</Culture>
      <PublicKeyToken>b03f5f7f11d50a3a</PublicKeyToken>
    </AssemblyBindingRedirect>
    <AssemblyBindingRedirect Include="System.Collections">
      <AssemblyVersion>0.0.0.0-9.0.0.0</AssemblyVersion>
      <NewVersion>6.0.0.0</NewVersion>
      <Culture>neutral</Culture>
      <PublicKeyToken>b03f5f7f11d50a3a</PublicKeyToken>
    </AssemblyBindingRedirect>
  </ItemGroup>

  <ItemGroup>
    <!-- MelonLoader核心 -->
    <Reference Include="MelonLoader">
      <HintPath>$(MelonLoaderPath)\net6\MelonLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    
    <!-- Harmony -->
    <Reference Include="0Harmony">
      <HintPath>$(MelonLoaderPath)\net6\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    
    <!-- Il2CppInterop -->
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(MelonLoaderPath)\net6\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Common">
      <HintPath>$(MelonLoaderPath)\net6\Il2CppInterop.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    
    <!-- Unity引擎核心 -->
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(MelonLoaderPath)\Il2CppAssemblies\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>$(MelonLoaderPath)\Il2CppAssemblies\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(MelonLoaderPath)\Il2CppAssemblies\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.JSONSerializeModule">
      <HintPath>$(MelonLoaderPath)\Il2CppAssemblies\UnityEngine.JSONSerializeModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(MelonLoaderPath)\Il2CppAssemblies\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    
    <!-- Il2Cpp mscorlib -->
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(MelonLoaderPath)\Il2CppAssemblies\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
