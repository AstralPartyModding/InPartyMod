# 编译输出
**/bin/
**/obj/
out/
publish/
*.dll
*.pdb
*.exe

# 替换资源文件（用户使用时存放替换好的mod不需要上传
替换mod/
*.bundle

# Mod管理器是独立仓库，这里不上传
@ModManager/

# mods目录只有_Template模板上传，其他内容不上传
mods/*
!mods/_Template/
!mods/_Template/**

# 旧版本和临时文件（不需要上传）
mod1/
migration-temp/
plans/

# 临时文件
*.tmp
*.temp
*.log
*.cache

# IDE配置
.vs/
.vscode/
*.user
*.suo

# 敏感信息
*.key
*.pem
*.pfx
secrets.json
appsettings.Development.json

# 压缩包
*.zip
*.rar
*.7z

# 媒体文件（预览视频等）
*.mp4
*.avi
*.mov

# 其他
.DS_Store

# 架构设计文档（开发完成后不上传）
docs/*-Architecture.md
docs/*-explanation.md
docs/PRELOAD_*.md
Thumbs.db
